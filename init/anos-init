#!/bin/sh
# 🦾 AnosOS Init — PID 1 via busybox init
# Uses /etc/inittab (busybox-style). No squashfs, no overlay needed.

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts /tmp /run /home/anos
mount -t devpts devpts /dev/pts 2>/dev/null || true

# Devices
for dev in tty0 tty1 tty2 tty3 tty4 console null zero random urandom; do
    [ -e "/dev/$dev" ] || mknod "/dev/$dev" c 4 $(echo "$dev" | sed 's/tty//') 2>/dev/null || true
done
[ -e /dev/console ] || mknod /dev/console c 5 1 2>/dev/null || true
[ -e /dev/null ] || mknod /dev/null c 1 3 2>/dev/null || true

# Network
NET_ONLINE=false
for mod in e1000 e1000e r8169 virtio_net tg3 igb; do
    modprobe $mod 2>/dev/null || find /lib/modules -name "${mod}.ko*" -exec insmod {} \; 2>/dev/null || true
done
for iface in eth0 enp0s3 ens3 ens4 enp1s0; do
    if [ -e "/sys/class/net/$iface" ]; then
        ip link set "$iface" up 2>/dev/null
        udhcpc -i "$iface" -n -q -t 5 2>/dev/null && NET_ONLINE=true && echo "  ✅ $iface" && break
    fi
done

# Hostname
hostname anos 2>/dev/null || echo "anos" > /proc/sys/kernel/hostname
echo "127.0.0.1 localhost anos" > /etc/hosts

# Anos daemon
export ANOS_DIR=/opt/anos
export ANOS_SOCKET=/tmp/anos.sock
mkdir -p /opt/anos/config /home/anos/.anos
chown anos:anos /home/anos /home/anos/.anos 2>/dev/null || true

echo "🦾 Starting Anos daemon..."
/usr/bin/anosd &
for i in $(seq 1 50); do [ -S /tmp/anos.sock ] && break; sleep 0.1; done

clear 2>/dev/null || printf "\033[2J\033[H"
echo ""
echo "╔══════════════════════════════════════════════╗"
echo "║       🦾 AnosOS — AI Native OS              ║"
echo "║          v2.0 — Ready                      ║"
echo "╠══════════════════════════════════════════════╣"
if $NET_ONLINE; then
    echo "║  🌐 Network: Online                         ║"
else
    echo "║  🌐 Network: Offline                        ║"
fi
echo "╠══════════════════════════════════════════════╣"
echo "║  Login:  anos / anos                         ║"
echo "║  Root:   root / root                         ║"
echo "║  ⚠️  CHANGE PASSWORDS on first login!       ║"
echo "╚══════════════════════════════════════════════╝"
echo ""

# Spawn getty on tty1-3 with respawn
for tty in tty1 tty2 tty3; do
    while true; do
        /sbin/getty 38400 "$tty"
        sleep 1
    done &
done

# Reap children
while true; do wait -n 2>/dev/null || true; done
