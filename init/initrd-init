#!/bin/sh
# 🦾 AnosOS Initrd — Ultra-minimal
# Only 2 files needed: /init + /bin/sh (busybox hardlink)
# All commands used MUST be busybox builtins

# Load ALL kernel modules we can find (storage drivers needed for CD/USB)
echo "🦾 Loading modules..."
if [ -d /lib/modules ]; then
    find /lib/modules -name '*.ko*' -exec /bin/busybox insmod {} \; 2>/dev/null
fi

# Mount proc/sys/dev
/bin/busybox mount -t proc proc /proc 2>/dev/null
/bin/busybox mount -t sysfs sys /sys 2>/dev/null
/bin/busybox mount -t devtmpfs dev /dev 2>/dev/null
/bin/busybox mkdir -p /dev/pts /tmp /cdrom
/bin/busybox mount -t devpts devpts /dev/pts 2>/dev/null || true

# Wait for storage
/bin/busybox sleep 2

# Try to mount CD on sr0/sr1
echo "🔍 Looking for AnosOS CD..."
FOUND=0
for dev in sr0 sr1; do
    if [ -b "/dev/$dev" ]; then
        if /bin/busybox mount -t iso9660 -o ro "/dev/$dev" /cdrom 2>/dev/null; then
            if [ -f /cdrom/sbin/init ] || [ -f /cdrom/bin/sh ]; then
                FOUND=1 && echo "✅ Found on /dev/$dev"
                break
            fi
            /bin/busybox umount /cdrom 2>/dev/null || true
        fi
    fi
done

# Fallback: list all block devices and try each
if [ $FOUND -eq 0 ]; then
    for dev in $(/bin/busybox ls /dev/sd* /dev/vd* /dev/nvme* 2>/dev/null); do
        if /bin/busybox mount -t iso9660 -o ro "$dev" /cdrom 2>/dev/null; then
            if [ -f /cdrom/sbin/init ] || [ -f /cdrom/bin/sh ]; then
                FOUND=1 && echo "✅ Found on $dev" && break
            fi
            /bin/busybox umount /cdrom 2>/dev/null || true
        fi
    done
fi

if [ $FOUND -eq 0 ]; then
    echo "❌ Cannot find AnosOS rootfs"
    echo "   Dropping to shell..."
    exec /bin/busybox sh
fi

# Pivot to CD root
echo "🦾 Booting..."
/bin/busybox mount --move /proc /cdrom/proc 2>/dev/null || true
/bin/busybox mount --move /sys /cdrom/sys 2>/dev/null || true
/bin/busybox mount --move /dev /cdrom/dev 2>/dev/null || true

exec /bin/busybox switch_root /cdrom /sbin/init
